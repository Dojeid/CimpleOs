#!/usr/bin/env bash
# =========================================================
# Falkon-OS Environment Configurator Wrapper (./configure)
# Delegates dependency verification to build.py
# =========================================================

if command -v python3 &> /dev/null; then
    python3 build.py -check
elif command -v python &> /dev/null; then
    python build.py -check
else
    echo "[!] ERROR: Python 3 is required to run Falkon-OS build system."
    exit 1
fi